{
  "name": "@trim21/php-serialize",
  "version": "0.2.2",
  "description": "PHP serialize/deserialize in Javascript",
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "sideEffects": false,
  "scripts": {
    "test": "NODE_OPTIONS=\"--no-warnings --experimental-vm-modules\" jest",
    "lint": "eslint .",
    "format": "prettier -w ./",
    "build": "esbuild src/index.ts --bundle --format=esm --sourcemap=linked --keep-names --packages=external --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "repository": "trim21/php-serialize",
  "author": "trim21",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trim21/php-serialize/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "src/*",
    "README.md",
    "dist/*"
  ],
  "homepage": "https://github.com/trim21/php-serialize#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 22"
  },
  "lint-staged": {
    "*.{md,js,cjs,mjs,jsx,ts,tsx,json,yml,yaml}": [
      "prettier --ignore-path ./.prettierignore --write"
    ],
    "*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.20.0",
  "prettier": {
    "semi": false,
    "printWidth": 125,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "coverageProvider": "v8"
  }
}
